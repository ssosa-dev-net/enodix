{
  "name": "enodix",
  "private": true,
  "version": "0.8.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --no-bundle",
    "test": "cargo test --workspace",
    "test:ui": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:hidden": "py scripts/run-on-desktop.py enodix-smoke target/smoke-hidden.log node scripts/smoke.mjs",
    "smoke:sandbox": "node scripts/sandbox.mjs smoke",
    "test:lab": "cargo build -p enodix-cli && cargo test -p enodix-core --test containerlab -- --ignored --nocapture --test-threads=1",
    "test:python": "node scripts/test-python.mjs",
    "test:release-gate": "bash scripts/test-release-gate.sh",
    "test:linux": "node scripts/test-linux.mjs",
    "test:linux-desktop": "node scripts/linux-desktop-check.mjs",
    "test:linux-fedora": "node scripts/linux-fedora-check.mjs",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-installer.ps1",
    "test:installer:sandbox": "node scripts/sandbox.mjs installer",
    "release": "node scripts/release.mjs",
    "release:linux": "node scripts/release-linux.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && npm run typecheck",
    "format": "cargo fmt --all && prettier --write .",
    "format:check": "cargo fmt --all --check && prettier --check .",
    "check": "npm run format:check && npm run lint && npm run test:ui && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.73.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
