{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "enodix",
  "identifier": "dev.enodix.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cargo build --release -p enodix-cli && node scripts/build-wheel.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: https://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Sergio Sosa",
    "shortDescription": "A terminal for network engineers",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
