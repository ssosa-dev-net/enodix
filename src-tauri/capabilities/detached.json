{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "detached",
  "description": "What a detached run or config history window may do: the main window's, and close itself.",
  "windows": ["run-*", "config-*"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging"
  ]
}
