/target/
/node_modules/
/dist/
/src-tauri/gen/
# Release signing keys never belong in the repository (see docs/releasing.md);
# only the public key, src-tauri/updater-key.pub, is committed.
*.key
# The containerlab suite's lab file holds the lab's addresses and maybe
# passwords (docs/containerlab.md); only lab/lab.example.yaml is committed.
/lab/lab.yaml
# What `containerlab deploy` leaves beside the topology.
/lab/clab-*/
/lab/.*.clab.yml.bak
# Python bytecode (the Python bridge, python/).
__pycache__/
